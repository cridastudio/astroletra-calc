# Shared secret the Worker sends in the X-Calc-Key header. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALC_KEY=change-me

# Optional. Directory with the 78 tarot PNG scans (<card_id>.png).
# Defaults to ./assets/tarot (or /app/assets/tarot in Docker). Without scans the image uses placeholders.
# TAROT_ASSETS_DIR=/app/assets/tarot

# Optional. Comma-separated hosts the PDF renderer may fetch http(s) resources from
# (images, fonts, CSS). Empty means only data: URIs and inline content are allowed.
# PDF_ALLOWED_HOSTS=example.com,cdn.example.com

# Optional. Public port for docker-compose (default 8000).
# CALC_PORT=8000
